rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function own(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    match /users/{uid} {
      allow read, create, update: if own(uid);
      allow delete: if false; // Deletion only via the authenticated Cloud Function.
      match /letters/{letterId} {
        allow read, create, update: if own(uid);
        allow delete: if own(uid);
        match /messages/{messageId} {
          allow read, create, update, delete: if own(uid);
        }
      }
    }
    match /subscriptions/{uid} {
      allow read: if own(uid);
      allow write: if false; // Store/webhook functions are authoritative.
    }
    match /deviceTokens/{token} {
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow read: if false;
    }
    match /adminMetrics/{period} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
