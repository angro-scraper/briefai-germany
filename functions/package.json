{
  "name": "briefai-functions",
  "engines": { "node": "22" },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "test": "node --test test/*.test.mjs",
    "serve": "npm run build && firebase emulators:start --only functions",
