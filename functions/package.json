    "founder:claim": "node scripts/set-founder-claim.mjs"
  },
  "dependencies": {
    "google-auth-library": "^9.15.1",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0",
    "openai": "^6.49.0",
    "stripe": "^17.0.0"
  },
  "devDependencies": { "typescript": "^5.7.0" }
}
