# Copy to `.env.briefai-germany` only on the trusted deployment machine.
# Values below are identifiers, not secrets. Secrets are configured with
# `firebase functions:secrets:set` and must never be placed in this file.
WEB_APP_ORIGIN=https://briefai-germany-download.onrender.com
OPENAI_MODEL=gpt-5.6-terra
ANDROID_PACKAGE_NAME=com.briefai.briefai_germany
APPLE_BUNDLE_ID=com.briefai.briefaiGermany
APPLE_APP_STORE_ISSUER_ID=REPLACE_WITH_APPLE_ISSUER_ID
APPLE_APP_STORE_KEY_ID=REPLACE_WITH_APPLE_KEY_ID
APPLE_APP_STORE_ENV=sandbox
STRIPE_PREMIUM_PRICE_ID=REPLACE_WITH_STRIPE_PRICE_ID
STRIPE_PRO_PRICE_ID=REPLACE_WITH_STRIPE_PRICE_ID
