# Never commit a real key. Use `firebase functions:secrets:set OPENAI_API_KEY`.
OPENAI_MODEL=gpt-4.1-mini
# Document AI processor ID (EU location) used for image/PDF OCR.
DOCUMENT_AI_PROCESSOR=REPLACE_WITH_PROCESSOR_ID
ANDROID_PACKAGE_NAME=com.briefai.briefai_germany
APPLE_BUNDLE_ID=com.briefai.briefaiGermany
APPLE_APP_STORE_ISSUER_ID=REPLACE_WITH_ISSUER_ID
APPLE_APP_STORE_KEY_ID=REPLACE_WITH_KEY_ID
APPLE_APP_STORE_ENV=production
WEB_APP_ORIGIN=https://app.example.com
STRIPE_PREMIUM_PRICE_ID=price_REPLACE_ME
STRIPE_PRO_PRICE_ID=price_REPLACE_ME
